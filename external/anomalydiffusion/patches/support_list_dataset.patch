+def _support_files(mvtec_path, sample_name, anomaly_name):
+    """Local patch: read the frozen project support list when SUPPORT_LIST is set.
+
+    Returns (image_paths, mask_paths) or None when SUPPORT_LIST is unset
+    (upstream behaviour). Fails loudly on a missing group or file.
+    """
+    import json
+    list_path = os.environ.get("SUPPORT_LIST")
+    if not list_path:
+        return None
+    groups = json.load(open(list_path))["groups"]
+    key = sample_name + "+" + anomaly_name
+    if key not in groups:
+        raise KeyError(f"[patch] {key} not in SUPPORT_LIST {list_path}")
+    imgs = [os.path.join(mvtec_path, r["image"]) for r in groups[key]]
+    masks = [os.path.join(mvtec_path, r["mask"]) for r in groups[key]]
+    for f in imgs + masks:
+        if not os.path.isfile(f):
+            raise FileNotFoundError(f"[patch] support file missing: {f}")
+    return imgs, masks
+
+
+def _support_pairs():
+    """Local patch: (sample, anomaly) pairs from SUPPORT_LIST, or None."""
+    import json
+    list_path = os.environ.get("SUPPORT_LIST")
+    if not list_path:
+        return None
+    groups = json.load(open(list_path))["groups"]
+    print(f"[patch] SUPPORT_LIST {list_path}: {len(groups)} groups, "
+          f"{sum(len(v) for v in groups.values())} images")
+    return [tuple(k.split("+")) for k in sorted(groups)]
+
